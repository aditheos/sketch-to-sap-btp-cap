# Copy to .env and fill in your key for local development.
# In BTP, bind the Credential Store service instead — no .env needed.
ANTHROPIC_API_KEY=sk-ant-...

# Model overrides (optional — defaults shown)
VISION_MODEL=claude-sonnet-4-6
VALIDATOR_MODEL=claude-haiku-4-5

# Set to true to enable rate limiting on the Aditheos demo subaccount
DEMO_MODE=false
