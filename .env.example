# Copy to .env and fill in your values for local development.
# In BTP, bind the appropriate service instead — no .env needed.

# ── Option 1: Direct Anthropic API key ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Option 2: SAP AI Core service binding ─────────────────────────────────────
# VCAP_SERVICES structure (must be a single-line JSON string in .env):
#
# {
#   "aicore": [
#     {
#       "credentials": {
#         "url":          "https://<tenant>.authentication.eu10.hana.ondemand.com",
#         "clientid":     "<clientid>",
#         "clientsecret": "<clientsecret>",
#         "serviceurls": {
#           "AI_API_URL": "https://api.ai.eu10.aws.ml.hana.ondemand.com"
#         }
#       }
#     }
#   ]
# }
#
# VCAP_SERVICES={"aicore":[{"credentials":{"url":"https://<tenant>.authentication.eu10.hana.ondemand.com","clientid":"<clientid>","clientsecret":"<clientsecret>","serviceurls":{"AI_API_URL":"https://api.ai.eu10.aws.ml.hana.ondemand.com"}}}]}

# Deployment IDs from SAP AI Launchpad → GenAI Hub → Models (one per model)
# VISION_DEPLOYMENT_ID=<claude-sonnet-deployment-id>
# VALIDATOR_DEPLOYMENT_ID=<claude-haiku-deployment-id>

# Resource group (default is fine unless your AI Core uses a custom one)
# AI_RESOURCE_GROUP=default

# ── Model overrides (optional — defaults shown) ────────────────────────────────
VISION_MODEL=claude-sonnet-4-6
VALIDATOR_MODEL=claude-haiku-4-5

# ── Demo mode (Aditheos hosted instance only) ──────────────────────────────────
DEMO_MODE=false
